<Window x:Class="ScreenFlowLite.Windows.RegionSelectorWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="调整录制区域" Width="900" Height="600" MinWidth="320" MinHeight="220"
 WindowStyle="None" AllowsTransparency="True" Background="#18FF3732" ResizeMode="CanResizeWithGrip"
 Topmost="True" WindowStartupLocation="CenterScreen">
 <Border BorderBrush="#FF3732" BorderThickness="4">
  <Grid><TextBlock Text="录制区域 · 拖动窗口移动，拖动边缘缩放" Foreground="#FF3732" FontSize="20" FontWeight="Bold" Margin="22"/>
   <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,24">
    <Button Content="取消" Click="Cancel_Click" Padding="22,8" Margin="6"/>
    <Button Content="开始录制此区域" Click="Confirm_Click" Padding="22,8" Margin="6" Background="#FF3732" Foreground="White"/>
   </StackPanel>
  </Grid>
 </Border>
</Window>
